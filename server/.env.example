# 服务器配置（复制为 .env 后按需修改）

# 服务端口
PORT=3001
NODE_ENV=development

# JWT 签名密钥（必须改！可用 node -e "console.log(require('crypto').randomBytes(48).toString('hex'))" 生成）
JWT_SECRET=please-change-me-to-a-random-64+-char-string
JWT_EXPIRES_IN=7d

# 学号脱敏盐值（必须改！生成方式同上）
STUDENT_ID_SALT=please-change-me-too

# 站点对外访问地址（用于邮件中的链接）
BASE_URL=http://localhost:3001

# 初始管理员邮箱（多个用逗号分隔，数据库启动时自动设为管理员）
ADMIN_EMAIL=your-email@example.com

# QQ邮箱 SMTP 配置（发送验证码用；SMTP_PASS 填 QQ 邮箱的授权码，不是登录密码）
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USER=your-qq-email@qq.com
SMTP_PASS=your-smtp-auth-code

# 验证码有效期（分钟）
VERIFY_CODE_EXPIRE_MINUTES=10

# 安全配置：CORS 白名单（逗号分隔；本地开发 5173 + 你的域名）
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# SQLite 数据库文件路径（默认 server/data/dajju.db，一般不用改）
# SQLITE_PATH=./data/dajju.db

# 可选 HTTP 陪练（不配置时使用本地文字陪练；BASE_URL 包含 /v1）
AI_BASE_URL=
AI_API_KEY=

# 可选小智语音，默认关闭；个人绑定用 personal，共享设备用 shared
XIAOZHI_IDENTITY_MODE=disabled
# XIAOZHI_COOKIE_SECRET 不配置时复用 JWT_SECRET
# XIAOZHI_COOKIE_SECRET=
# XIAOZHI_SHARED_IDENTITY_B64=
